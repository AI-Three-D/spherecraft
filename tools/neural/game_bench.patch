+// Mean premultiplied radiance and transmittance of the displayed cloud target on the reference grid.
+export async function readCloudHdr({ width, height }) {
+    const clouds = volumetricClouds;
+    const { TeacherGpu } = await import('/neural_lab/teacherGpu.js');
+    const teacher = new TeacherGpu(clouds);
+    const out = clouds.device.createBuffer({ size: width * height * 16, usage: GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_SRC });
+    const params = teacher.uniformBuffer(new Float32Array([width, height, 0, 0]));
+    const pipeline = await teacher.pipeline(`
+@group(0) @binding(0) var color: texture_2d<f32>;
+@group(0) @binding(1) var<uniform> params: vec4f;
+@group(0) @binding(2) var<storage, read_write> outValues: array<vec4f>;
+@compute @workgroup_size(8, 8)
+fn main(@builtin(global_invocation_id) id: vec3u) {
+    let size = vec2u(params.xy);
+    if (any(id.xy >= size)) { return; }
+    let dim = vec2f(textureDimensions(color));
+    let a = vec2i(vec2f(id.xy) * dim / params.xy); let b = vec2i(vec2f(id.xy + 1u) * dim / params.xy);
+    var sum = vec4f(0.0);
+    for (var y = a.y; y < b.y; y++) { for (var x = a.x; x < b.x; x++) { sum += textureLoad(color, vec2i(x, y), 0); } }
+    outValues[id.y * size.x + id.x] = sum / f32(max(1, (b.x - a.x) * (b.y - a.y)));
+}`, 'read cloud hdr');
+    await teacher.run(pipeline, [clouds.getOutputs().colorView, { buffer: params }, { buffer: out }], [Math.ceil(width / 8), Math.ceil(height / 8)]);
+    const values = Array.from(await teacher.read(out, width * height * 16));
+    out.destroy(); params.destroy();
+    return values;
+}
